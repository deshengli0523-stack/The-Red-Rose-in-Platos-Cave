{
  "additionalProperties": false,
  "properties": {
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string",
      "x-utc-only": true
    },
    "approver_role": {
      "const": "primary_counselor",
      "title": "Approver Role",
      "type": "string"
    },
    "descriptor_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Descriptor Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string",
      "x-utc-only": true
    },
    "nonce": {
      "minLength": 1,
      "not": {
        "pattern": "^[\\x09-\\x0d\\x1c-\\x20\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+$"
      },
      "title": "Nonce",
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "not": {
        "pattern": "^[\\x09-\\x0d\\x1c-\\x20\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+$"
      },
      "title": "Provider Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 101,
      "minLength": 38,
      "not": {
        "anyOf": [
          {
            "pattern": "client_[a-z0-9]{12}"
          },
          {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          }
        ]
      },
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "signature": {
      "minLength": 1,
      "not": {
        "pattern": "^[\\x09-\\x0d\\x1c-\\x20\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+$"
      },
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "descriptor_sha256",
    "approver_role",
    "approved_at",
    "expires_at",
    "nonce",
    "provider_id",
    "signature"
  ],
  "title": "ApprovalReceipt",
  "type": "object"
}
