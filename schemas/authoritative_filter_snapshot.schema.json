{
  "$defs": {
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "object_id": {
          "maxLength": 101,
          "minLength": 38,
          "not": {
            "anyOf": [
              {
                "pattern": "client_[a-z0-9]{12}"
              },
              {
                "pattern": "[\\r\\n\\u2028\\u2029]"
              }
            ]
          },
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Object Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "object_id",
        "version",
        "content_sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_ref_ids": {
      "items": {
        "maxLength": 101,
        "minLength": 38,
        "not": {
          "anyOf": [
            {
              "pattern": "client_[a-z0-9]{12}"
            },
            {
              "pattern": "[\\r\\n\\u2028\\u2029]"
            }
          ]
        },
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "title": "Allowed Ref Ids",
      "type": "array",
      "uniqueItems": true
    },
    "authorization_epoch": {
      "minimum": 0,
      "title": "Authorization Epoch",
      "type": "integer"
    },
    "client_runtime_epoch": {
      "minimum": 0,
      "title": "Client Runtime Epoch",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string",
      "x-utc-only": true
    },
    "global_runtime_epoch": {
      "minimum": 0,
      "title": "Global Runtime Epoch",
      "type": "integer"
    },
    "policy_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "run_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "tombstone_epoch": {
      "minimum": 0,
      "title": "Tombstone Epoch",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "global_runtime_epoch",
    "client_runtime_epoch",
    "tombstone_epoch",
    "authorization_epoch",
    "allowed_ref_ids",
    "policy_ref",
    "created_at"
  ],
  "title": "AuthoritativeFilterSnapshot",
  "type": "object"
}
