{
  "$defs": {
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "object_id": {
          "maxLength": 101,
          "minLength": 38,
          "not": {
            "anyOf": [
              {
                "pattern": "client_[a-z0-9]{12}"
              },
              {
                "pattern": "[\\r\\n\\u2028\\u2029]"
              }
            ]
          },
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Object Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "object_id",
        "version",
        "content_sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "case_contributor_count": {
          "const": 0
        },
        "case_count": {
          "const": 0
        },
        "client_exclusion_status": {
          "const": "not_applicable"
        },
        "independent_source_count": {
          "minimum": 1
        },
        "provenance_scope": {
          "const": "global_source"
        },
        "source_count": {
          "minimum": 1
        }
      }
    },
    {
      "properties": {
        "case_contributor_count": {
          "const": 0
        },
        "case_count": {
          "const": 0
        },
        "client_exclusion_status": {
          "const": "current_subject_private"
        },
        "independent_source_count": {
          "const": 0
        },
        "provenance_scope": {
          "const": "client_private"
        },
        "source_count": {
          "const": 0
        }
      }
    },
    {
      "properties": {
        "case_contributor_count": {
          "minimum": 1
        },
        "case_count": {
          "minimum": 1
        },
        "client_exclusion_status": {
          "enum": [
            "no_subject_contribution",
            "leave_one_subject_out_applied"
          ]
        },
        "independent_source_count": {
          "const": 0
        },
        "provenance_scope": {
          "const": "case_derived"
        },
        "source_count": {
          "const": 0
        }
      }
    },
    {
      "properties": {
        "case_contributor_count": {
          "minimum": 1
        },
        "case_count": {
          "minimum": 1
        },
        "client_exclusion_status": {
          "enum": [
            "no_subject_contribution",
            "leave_one_subject_out_applied"
          ]
        },
        "independent_source_count": {
          "minimum": 1
        },
        "provenance_scope": {
          "const": "mixed"
        },
        "source_count": {
          "minimum": 1
        }
      }
    }
  ],
  "properties": {
    "case_contributor_count": {
      "minimum": 0,
      "title": "Case Contributor Count",
      "type": "integer"
    },
    "case_count": {
      "minimum": 0,
      "title": "Case Count",
      "type": "integer"
    },
    "client_exclusion_status": {
      "enum": [
        "not_applicable",
        "current_subject_private",
        "no_subject_contribution",
        "leave_one_subject_out_applied"
      ],
      "title": "Client Exclusion Status",
      "type": "string"
    },
    "derivation_rule_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "independent_source_count": {
      "minimum": 0,
      "title": "Independent Source Count",
      "type": "integer"
    },
    "passage_count": {
      "minimum": 0,
      "title": "Passage Count",
      "type": "integer"
    },
    "provenance_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "provenance_scope": {
      "enum": [
        "global_source",
        "client_private",
        "case_derived",
        "mixed"
      ],
      "title": "Provenance Scope",
      "type": "string"
    },
    "source_count": {
      "minimum": 0,
      "title": "Source Count",
      "type": "integer"
    }
  },
  "required": [
    "provenance_ref",
    "provenance_scope",
    "derivation_rule_ref",
    "source_count",
    "passage_count",
    "case_count",
    "case_contributor_count",
    "independent_source_count",
    "client_exclusion_status"
  ],
  "title": "EvidenceProvenanceView",
  "type": "object",
  "x-runtime-only-invariants": [
    "independent_source_count_lte_source_count"
  ]
}
