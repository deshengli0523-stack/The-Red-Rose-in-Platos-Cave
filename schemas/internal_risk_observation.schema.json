{
  "$defs": {
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "object_id": {
          "maxLength": 101,
          "minLength": 38,
          "not": {
            "anyOf": [
              {
                "pattern": "client_[a-z0-9]{12}"
              },
              {
                "pattern": "[\\r\\n\\u2028\\u2029]"
              }
            ]
          },
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Object Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "object_id",
        "version",
        "content_sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "category": {
      "maxLength": 64,
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "client_[a-z0-9]{12}"
          },
          {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          }
        ]
      },
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "title": "Category",
      "type": "string"
    },
    "client_facing_visibility": {
      "const": "never",
      "default": "never",
      "title": "Client Facing Visibility",
      "type": "string"
    },
    "detected_at": {
      "format": "date-time",
      "title": "Detected At",
      "type": "string",
      "x-utc-only": true
    },
    "level": {
      "enum": [
        "general",
        "high"
      ],
      "title": "Level",
      "type": "string"
    },
    "observation_id": {
      "maxLength": 101,
      "minLength": 38,
      "not": {
        "anyOf": [
          {
            "pattern": "client_[a-z0-9]{12}"
          },
          {
            "pattern": "[\\r\\n\\u2028\\u2029]"
          }
        ]
      },
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Observation Id",
      "type": "string"
    },
    "rule_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suggested_questions": {
      "items": {
        "minLength": 1,
        "not": {
          "pattern": "^[\\x09-\\x0d\\x1c-\\x20\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+$"
        },
        "type": "string"
      },
      "minItems": 1,
      "title": "Suggested Questions",
      "type": "array",
      "uniqueItems": true
    },
    "trigger_turn_ids": {
      "items": {
        "maxLength": 36,
        "minLength": 36,
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Trigger Turn Ids",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "observation_id",
    "category",
    "level",
    "trigger_turn_ids",
    "rule_ref",
    "detected_at",
    "suggested_questions"
  ],
  "title": "InternalRiskObservation",
  "type": "object"
}
