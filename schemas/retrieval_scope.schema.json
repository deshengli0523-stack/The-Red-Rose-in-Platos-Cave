{
  "additionalProperties": false,
  "properties": {
    "allowed_uses": {
      "items": {
        "minLength": 1,
        "not": {
          "pattern": "^[\\x09-\\x0d\\x1c-\\x20\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+$"
        },
        "type": "string"
      },
      "title": "Allowed Uses",
      "type": "array",
      "uniqueItems": true
    },
    "current_client_id": {
      "maxLength": 19,
      "minLength": 19,
      "not": {
        "pattern": "[\\r\\n\\u2028\\u2029]"
      },
      "pattern": "^client_[a-z0-9]{12}$",
      "title": "Current Client Id",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string",
      "x-utc-only": true
    },
    "known_at": {
      "format": "date-time",
      "title": "Known At",
      "type": "string",
      "x-utc-only": true
    },
    "maximum_sensitivity": {
      "minimum": 0,
      "title": "Maximum Sensitivity",
      "type": "integer"
    }
  },
  "required": [
    "current_client_id",
    "allowed_uses",
    "maximum_sensitivity",
    "effective_at",
    "known_at"
  ],
  "title": "RetrievalScope",
  "type": "object"
}
